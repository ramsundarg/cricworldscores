rules_version = '2';
// Simple open rules for a friends' scoring app on the free tier.
// Anyone with the link can read (viewers) and write (scorer).
// The scorer PIN in the app is light protection against accidental edits,
// not real security. If you ever need to lock it down, switch to
// Firebase Anonymous Auth and require request.auth != null below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{matchId} {
      allow read, write: if true;
    }
    match /teams/{teamId} {
      allow read, write: if true;
    }
    match /leagues/{leagueId} {
      allow read, write: if true;
    }
    match /seasons/{seasonId} {
      allow read, write: if true;
    }
    match /practices/{practiceId} {
      allow read, write: if true;
    }
  }
}
